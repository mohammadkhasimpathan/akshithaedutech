# Akshitha Edutech Job Portal - Environment Variables Template
# Copy this file to .env.local and populate with your Supabase project credentials.

# -----------------------------------------------------------------------------
# Public Supabase Configuration (Safe for Browser & Client-side code)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Private Supabase Configuration (CRITICAL: SERVER-ONLY, NEVER EXPOSE TO CLIENT)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -----------------------------------------------------------------------------
# Optional App Settings
# -----------------------------------------------------------------------------
# Set to 'true' in development to enable local mock data fallback when Supabase is not configured yet
NEXT_PUBLIC_ENABLE_LOCAL_MOCKS=false
